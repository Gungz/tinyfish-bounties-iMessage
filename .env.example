# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# TinyFish Web Agent (get one at https://agent.tinyfish.ai/api-keys).
# Put your real key in `.env` (same names) — never commit `.env`.
TINYFISH_API_KEY=

# Gemini Flash via AI Studio (https://aistudio.google.com/app/apikey) — free tier.
# Put your real key in `.env`. GEMINI_MODEL can stay as-is.
# GEMINI_FALLBACK_MODEL is tried when the primary model's free quota is
# exhausted (quotas are per-model, so rotation often works immediately).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Brain resilience: per-call timeout (bad models fail fast instead of hanging),
# then backoff retry + fallback-model rotation, then zero-LLM deterministic chain.
LLM_TIMEOUT_MS=60000

# Agent bounding: async queue + poll with client deadline, server-side caps.
# Worst case a turn waits ~AGENT_TIMEOUT_MS before degrading gracefully.
AGENT_TIMEOUT_MS=90000
AGENT_MAX_STEPS=12
AGENT_MAX_DURATION_SECONDS=75

# Dev-only, never set in production:
# ENABLE_TERMINAL=1 — include the terminal TUI provider (needs 127.0.0.1
#   loopback + a TTY for its tuichat subprocess; otherwise use `yarn chat`).
# SIMULATE_QUOTA_EXHAUSTION=1 — force the quota-fallback path with a
#   synthetic error (zero real quota consumed).
